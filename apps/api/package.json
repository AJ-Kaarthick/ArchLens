{
  "name": "@archlens/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push:pg"
  },
  "dependencies": {
    "@archlens/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google/genai": "^2.21.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.26.0",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@archlens/eslint-config": "workspace:*",
    "@archlens/tsconfig": "workspace:*",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.20.18",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
