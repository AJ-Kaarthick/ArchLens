# ArchLens Backend Environment Configuration (apps/api/.env)

# PostgreSQL Database Connection & Pool Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/archlens
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
# Optional: Set to 'require' or 'prefer' for managed cloud databases (e.g. AWS RDS, Neon, Supabase)
DB_SSL=

# GitHub Personal Access Token (Server-Side Only)
# Optional: Increases GitHub REST API rate limits from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Google Gemini API Key (Server-Side Only)
# Optional: Enables Gemini-powered grounded repository explanations and embeddings.
# When omitted, ArchLens automatically uses Mock providers for 100% offline development.
GEMINI_API_KEY=

# Provider Overrides ('gemini' or 'mock')
AI_PROVIDER=
EMBEDDING_PROVIDER=

# Model Configuration
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Google Gemini Fallback Configuration (Server-Side Only)
# Optional: Enables high-availability fallback to a secondary project key/model when primary hits transient 503/429/5xx errors.
GEMINI_FALLBACK_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Google Gemini Tertiary Fallback Configuration (Server-Side Only)
# Optional: Third-tier low-latency fallback model when primary and secondary models experience high demand.
GEMINI_TERTIARY_API_KEY=
GEMINI_TERTIARY_MODEL=gemini-3.6-flash

# Gemini Generation Thinking Level ('LOW', 'MINIMAL', 'MEDIUM', 'HIGH')
# Defaults to 'LOW' for fast, grounded JSON explanation synthesis without extraneous reasoning delay.
GEMINI_THINKING_LEVEL=LOW

# API Server Networking & Logging
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Reverse Proxy / Trust Proxy Configuration
# Defaults to trusting private networks / loopbacks (['loopback', 'linklocal', 'uniquelocal'])
# Suitable for Docker Compose / Nginx topologies. Set to 'false' to disable, or specify subnets.
TRUST_PROXY=

# In-Memory Rate Limiting (Single-Instance Protection)
# Window size in milliseconds (defaults to 60000ms / 1 minute)
RATE_LIMIT_TIME_WINDOW_MS=60000
# Category-specific rate limits (requests per time window)
RATE_LIMIT_ANALYZE_MAX=10
RATE_LIMIT_EXECUTE_MAX=10
RATE_LIMIT_EXPLAIN_MAX=20
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_GENERAL_MAX=120

# Sandboxed Execution Security Containment
# Default is strictly DISABLED (false) across all environments.
# SECURITY NOTICE:
# ArchLens execution uses a host-process Node runner under the API user. It is NOT kernel-isolated
# (not a container/microVM) and CANNOT safely contain hostile code. In the normal product, execution
# and preview routes are not registered.
# For local unsafe development only, set to 'yes' / 'true':
ENABLE_UNSAFE_DEV_SANDBOX=false
