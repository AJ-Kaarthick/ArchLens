# ==============================================================================
# ArchLens - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env and adjust values for local development or container deployment.

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Reverse proxy trust settings for Fastify:
# Options: 'loopback', 'linklocal', 'uniquelocal', boolean, or specific CIDRs / hop counts.
TRUST_PROXY=loopback

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5433/archlens

# Docker Compose database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=archlens
POSTGRES_PORT=5433

# Database Connection Pool Tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
# Set to 'require' for TLS-enabled connections (e.g. AWS RDS, Neon, Supabase)
DB_SSL=false

# ------------------------------------------------------------------------------
# Ingress & Public Port Mappings (Docker Compose)
# ------------------------------------------------------------------------------
# Web UI / Nginx public reverse proxy port
WEB_PORT=8080

# API port (bound strictly to 127.0.0.1 on the host to avoid exposing unproxied ports)
API_PORT=3000

# ------------------------------------------------------------------------------
# GitHub REST API Integration
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (classic or fine-grained).
# Unauthenticated requests are limited to 60 requests/hour by GitHub.
# Supplying a token increases the limit to 5,000 requests/hour.
# Permissions needed: read-only access to public repositories.
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# AI & LLM Services (Optional)
# ------------------------------------------------------------------------------
# Primary Google Gemini API Key for grounded architectural insights & embeddings
GEMINI_API_KEY=

# Optional fallback keys/models for resilience during upstream service disruptions
GEMINI_FALLBACK_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_TERTIARY_API_KEY=
GEMINI_TERTIARY_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=LOW

# Independent OpenAI-compatible fallback provider (e.g. OpenRouter, OpenAI, local Ollama)
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=gpt-4o-mini

# Provider selection: 'gemini', 'openai', 'mock', 'none' (leave blank for auto-detection)
AI_PROVIDER=

# Embedding provider selection: 'gemini', 'none' (leave blank for auto-detection)
EMBEDDING_PROVIDER=

# Set to 'true' to explicitly disable AI insights regardless of key presence
AI_DISABLED=false

# ------------------------------------------------------------------------------
# Opt-In Development Execution (Unsafe Host Child-Process)
# ------------------------------------------------------------------------------
# Host-process repository execution and live preview are DISABLED by default.
# SECURITY NOTICE: Execution runs directly as an ephemeral child process on the
# host machine. It is NOT kernel-isolated or microVM-sandboxed and is unsafe for
# untrusted or malicious code.
#
# Set to 'true', 'yes', or '1' strictly in trusted local development environments.
ENABLE_UNSAFE_DEV_SANDBOX=false

# ------------------------------------------------------------------------------
# Rate Limiting (Requests per minute per IP)
# ------------------------------------------------------------------------------
RATE_LIMIT_ANALYZE_MAX=10
RATE_LIMIT_EXECUTE_MAX=10
RATE_LIMIT_EXPLAIN_MAX=20
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_GENERAL_MAX=120
